# Copy to `.env` and adjust. Turbo hashes these into the task cache.
# Every variable listed here is also declared in turbo.json so that the
# `turbo/no-undeclared-env-vars` lint rule stays satisfied.

# --- apps/api ---
SERVICE_NAME=api
APP_VERSION=0.0.0
PORT=4000
# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
