{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for every payload that crosses the HTTP boundary of this monorepo.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
